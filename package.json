{
  "name": "gitool",
  "productName": "Gitool",
  "version": "0.10.1",
  "private": false,
  "type": "module",
  "description": "Windows Git repository workspace",
  "author": "gitool",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite --mode web",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b && tsc -p tsconfig.electron.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:ui": "vitest run src/components src/test",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:ui": "node scripts/ui-guard.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"electron/**/*.ts\" \"shared/**/*.ts\" \"*.{ts,json,yml}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"electron/**/*.ts\" \"shared/**/*.ts\" \"*.{ts,json,yml}\"",
    "preview": "vite preview",
    "dist": "npm run build && electron-builder --win --x64"
  },
  "dependencies": {
    "@napi-rs/keyring": "^2.1.0",
    "lucide-react": "^0.468.0",
    "markdown-it": "^15.0.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.1.0",
    "axe-core": "^4.14.1",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "jsdom": "^31.0.1",
    "prettier": "^3.9.10",
    "stylelint": "^18.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-electron": "^1.1.2",
    "vitest": "^5.0.5"
  }
}
